--- a/src/greet.ts
+++ b/src/greet.ts
@@ -1,3 +1,7 @@
 export function greet(name: string): string {
   return `Hello, ${name}`;
 }
+
+export function farewell(name: string): string {
+  return `Goodbye, ${name}`;
+}
