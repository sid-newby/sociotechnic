{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow lead replies",
  "description": "Use only the definition named by the active phase. Engine validation also enforces exact required slots, frozen resource eligibility, node ceilings and intent verdict consistency. Missing decisions use needs-input. No response can expand tools, change frozen releases or approve its own technical evidence.",
  "$defs": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "agent",
        "version"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "needsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "questions"
      ],
      "properties": {
        "status": {
          "const": "needs-input"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "intake": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "brief",
            "selections"
          ],
          "properties": {
            "status": {
              "const": "ready"
            },
            "brief": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "selections": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/choice"
              }
            }
          }
        },
        {
          "$ref": "#/$defs/needsInput"
        }
      ],
      "examples": [
        {
          "status": "ready",
          "brief": "Keep the requested report deliverable; inspect the existing evidence and return a scoped plan.",
          "selections": [
            {
              "slot": "sociotechnic-planner",
              "agent": "sociotechnic-planner",
              "version": "1.0.0"
            }
          ]
        }
      ]
    },
    "assignment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "selections",
            "concurrency",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "ready"
            },
            "selections": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/choice"
              }
            },
            "concurrency": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          }
        },
        {
          "$ref": "#/$defs/needsInput"
        }
      ],
      "examples": [
        {
          "status": "ready",
          "selections": [
            {
              "slot": "sociotechnic-builder-lite",
              "agent": "sociotechnic-builder-lite",
              "version": "1.0.0"
            }
          ],
          "concurrency": {
            "reviews": 2
          },
          "reason": "One builder owns the worktree; independent readers may overlap."
        }
      ]
    },
    "intent-review": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "summary",
            "findings"
          ],
          "properties": {
            "status": {
              "enum": [
                "aligned",
                "changes"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        },
        {
          "$ref": "#/$defs/needsInput"
        }
      ],
      "examples": [
        {
          "status": "aligned",
          "summary": "The committed result supplies the requested report and acceptance evidence.",
          "findings": []
        }
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "questions"
      ],
      "properties": {
        "status": {
          "const": "needs-input"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  }
}
